# --- Database ---
# Docker Compose: only POSTGRES_PASSWORD is needed (DATABASE_URL is built for you).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Managed database (Supabase, Neon, DigitalOcean): set the full URL instead.
DATABASE_URL=postgresql://user:password@host:5432/royallink
# Set to true for managed databases that require SSL
DATABASE_SSL=false

# --- App ---
# 32+ random characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=
# Public address, used in the passenger QR codes
APP_URL=https://transport.royalhorizonmw.com
